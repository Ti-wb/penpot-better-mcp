# Copy to .env for a new setup; keep an existing .env private.
# Replace the example origin with your own site. Never commit real endpoints.
# Keep .env private. The login session and gateway token belong in .state/.

# Shared gateway and login settings: Docker Compose and native Node.
PENPOT_BASE_URL=https://penpot.example.com
# Resident file browsers (1-16). More parallel files require more CPU/RAM.
PENPOT_MAX_WORKERS=2
# Idle reclamation in milliseconds; 600000 = 10 minutes (minimum 1000).
PENPOT_IDLE_MS=600000
# Set false to disable routine operation logs.
PENPOT_DIAGNOSTICS=true

# Docker Compose settings.
# HTTP binds to 127.0.0.1; update the MCP client URL if changing this port.
GATEWAY_PORT=4545
# MCP client endpoint; keep its port aligned with GATEWAY_PORT.
# This is a client setting, not a Docker container listen address.
GATEWAY_HTTP_URL=http://127.0.0.1:4545/mcp
# Allow accepted operations and saves to finish before Docker forces a stop.
GATEWAY_STOP_GRACE_PERIOD=5m
# Match the host user/group that owns .state/ (id -u / id -g).
LOCAL_UID=1000
LOCAL_GID=1000

# Native Node only: Compose supplies its own upstream URLs and session path.
# Compose does not forward PENPOT_TIMEOUT_MS; it affects native Node only here.
PENPOT_UPSTREAM_HTTP=http://127.0.0.1:14401/mcp
PENPOT_UPSTREAM_WS=ws://127.0.0.1:14402
PENPOT_STORAGE_STATE=.state/session.json
PENPOT_TIMEOUT_MS=120000
# Native Node needs exported variables or node --env-file=.env dist/main.js.

# Optional acceptance tests against your own dedicated files.
# Uncomment these in .env, then run the test with node --env-file=.env.
# Keep workspace URLs and file IDs in the ignored manifest, never in this file.
# E2E_TARGETS_FILE=.state/acceptance-targets.json
# E2E_HTTP_URL=http://127.0.0.1:4545/mcp
